<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: Mineral deposit located -->
  <LocalMineralScanner_LetterLabelFoundDeposit>Mineralvorkommen entdeckt</LocalMineralScanner_LetterLabelFoundDeposit>
  <!-- EN: {FINDER_nameDef} has located a deposit of {0} in an undiscovered area using the local mineral scanner. -->
  <LocalMineralScanner_LetterFoundDeposit>{FINDER_nameDef} hat mit dem lokalen Mineralscanner ein {0}vorkommen in einem unentdeckten Gebiet gefunden.</LocalMineralScanner_LetterFoundDeposit>
  <!-- EN: No more undiscovered {0} deposits remain on this map. The local mineral scanner will remain idle until it is tuned to another mineral. -->
  <LocalMineralScanner_MessageExhausted>Auf dieser Karte gibt es keine unentdeckten {0}vorkommen mehr. Der lokale Mineralscanner bleibt untätig, bis er auf ein anderes Mineral eingestellt wird.</LocalMineralScanner_MessageExhausted>
  <!-- EN: no undiscovered {0} deposits left -->
  <LocalMineralScanner_NoFoggedDeposits>keine unentdeckten {0}vorkommen mehr</LocalMineralScanner_NoFoggedDeposits>
  <!-- EN: none undiscovered -->
  <LocalMineralScanner_NoneUndiscovered>keine unentdeckten</LocalMineralScanner_NoneUndiscovered>
  <!-- EN: Combined scanning speed ({0} operators) -->
  <LocalMineralScanner_CombinedScanSpeed>Kombinierte Scangeschwindigkeit ({0} Benutzer)</LocalMineralScanner_CombinedScanSpeed>

  <!-- Ancient cryptosleep caskets (opt-in target). The letter's {0} arrives with its article
       ("an ancient cryptosleep casket"); the other two take the bare label ("ancient
       cryptosleep casket"), whose grammatical gender can differ between casket variants.
       NoFoggedCaskets is a lower-case fragment like NoFoggedDeposits. The letter stays neutral: caskets also sit in ruins
       and quest structures that hold nothing dangerous, so it must not call them a danger. -->
  <!-- EN: Casket located -->
  <LocalMineralScanner_LetterLabelFoundCasket>Kapsel entdeckt</LocalMineralScanner_LetterLabelFoundCasket>
  <!-- EN: {FINDER_nameDef} has located {0} in an undiscovered area using the local mineral scanner. Explore the area to find out what is inside and what else lies nearby. -->
  <LocalMineralScanner_LetterFoundCasket>{FINDER_nameDef} hat mit dem lokalen Mineralscanner {0} in einem unentdeckten Gebiet gefunden. Erkunde das Gebiet, um herauszufinden, was sie enthält und was sich sonst in der Nähe befindet.</LocalMineralScanner_LetterFoundCasket>
  <!-- EN: No undiscovered {0} remains on this map. The local mineral scanner will remain idle until it is tuned to something else. -->
  <LocalMineralScanner_MessageExhaustedCaskets>Auf dieser Karte gibt es keine unentdeckte {0} mehr. Der lokale Mineralscanner bleibt untätig, bis er auf etwas anderes eingestellt wird.</LocalMineralScanner_MessageExhaustedCaskets>
  <!-- EN: no undiscovered {0} left -->
  <LocalMineralScanner_NoFoggedCaskets>keine unentdeckte {0} mehr</LocalMineralScanner_NoFoggedCaskets>
  <!-- Shown in place of NoFoggedCaskets / NoneUndiscovered for a scanner still tuned to a
       casket after the setting is turned off. Lower-case fragment. -->
  <!-- EN: disabled in mod settings -->
  <LocalMineralScanner_CasketsDisabled>in den Mod-Einstellungen deaktiviert</LocalMineralScanner_CasketsDisabled>

  <!-- "Any mineral" tuning: the menu's first row, and the gizmo label after "Scan for:". Each
       find then reveals a random undiscovered target; whether caskets can be drawn is the
       RandomIncludesCaskets setting, so NothingUndiscovered (a lower-case fragment like
       NoFoggedDeposits) and MessageExhaustedAll are worded to hold either way. -->
  <!-- EN: Any mineral -->
  <LocalMineralScanner_AnyMineral>Jedes Mineral</LocalMineralScanner_AnyMineral>
  <!-- EN: nothing undiscovered left to find -->
  <LocalMineralScanner_NothingUndiscovered>nichts Unentdecktes mehr zu finden</LocalMineralScanner_NothingUndiscovered>
  <!-- EN: Nothing undiscovered remains on this map for the local mineral scanner to find. It will remain idle. -->
  <LocalMineralScanner_MessageExhaustedAll>Auf dieser Karte gibt es nichts Unentdecktes mehr, das der lokale Mineralscanner finden könnte. Er bleibt untätig.</LocalMineralScanner_MessageExhaustedAll>

  <!-- Settings window. *Desc keys are hover tooltips. SettingsCategory is also the Workshop
       title and must equal the first line of .steamworkshop/Description/<Language>.txt. -->
  <!-- EN: Local Mineral Scanner -->
  <LocalMineralScanner_SettingsCategory>Lokaler Mineralscanner</LocalMineralScanner_SettingsCategory>
  <!-- EN: Placement -->
  <LocalMineralScanner_SettingsPlacement>Platzierung</LocalMineralScanner_SettingsPlacement>
  <!-- EN: Scanning -->
  <LocalMineralScanner_SettingsScanning>Scannen</LocalMineralScanner_SettingsScanning>
  <!-- Appended to a slider label; keep the leading space. VanillaSuffix marks a value one of
       vanilla's scanners uses; {0} = that scanner's label. -->
  <!-- EN:  (default) -->
  <LocalMineralScanner_DefaultSuffix> (Standard)</LocalMineralScanner_DefaultSuffix>
  <!-- EN:  ({0}) -->
  <LocalMineralScanner_VanillaSuffix> ({0})</LocalMineralScanner_VanillaSuffix>

  <!-- {0} = vanilla building label (long-range mineral scanner / deep drill). -->
  <!-- EN: Doesn't work under a roof -->
  <LocalMineralScanner_RequireUnroofed>Funktioniert nicht unter einem Dach</LocalMineralScanner_RequireUnroofed>
  <!-- EN: When enabled, the scanner can't be built or operated under a roof, like the {0}. When disabled, it will work anywhere. -->
  <LocalMineralScanner_RequireUnroofedDesc>Wenn aktiviert, kann der Scanner nicht unter einem Dach gebaut oder bedient werden, wie der {0}. Wenn deaktiviert, funktioniert er überall.</LocalMineralScanner_RequireUnroofedDesc>
  <!-- EN: Can be uninstalled -->
  <LocalMineralScanner_Minifiable>Kann demontiert werden</LocalMineralScanner_Minifiable>
  <!-- EN: When enabled, the scanner can be uninstalled and moved, like the {0}. When disabled, it can only be deconstructed. -->
  <LocalMineralScanner_MinifiableDesc>Wenn aktiviert, kann der Scanner demontiert und versetzt werden, wie der {0}. Wenn deaktiviert, kann er nur abgerissen werden.</LocalMineralScanner_MinifiableDesc>
  <!-- EN: The mass of the uninstalled scanner when it is hauled or carried by a caravan. -->
  <LocalMineralScanner_MassDesc>Die Masse des demontierten Scanners, wenn er transportiert oder von einer Karawane mitgeführt wird.</LocalMineralScanner_MassDesc>

  <!-- {0} = the long-range mineral scanner's label, {1} = its own value for this setting. -->
  <!-- EN: The average number of working days between finds, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindMtbDaysDesc>Die durchschnittliche Anzahl der Arbeitstage zwischen zwei Funden für einen Benutzer bei 100% Forschungsgeschwindigkeit. Beim {0} sind es {1}.</LocalMineralScanner_FindMtbDaysDesc>
  <!-- EN: Guaranteed find interval -->
  <LocalMineralScanner_FindGuaranteedDays>Intervall bis zum garantierten Fund</LocalMineralScanner_FindGuaranteedDays>
  <!-- EN: The number of working days until a find is guaranteed, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindGuaranteedDaysDesc>Die Anzahl der Arbeitstage bis zu einem garantierten Fund für einen Benutzer bei 100% Forschungsgeschwindigkeit. Beim {0} sind es {1}.</LocalMineralScanner_FindGuaranteedDaysDesc>

  <!-- {0} = the vanilla ancient cryptosleep casket's label. -->
  <!-- EN: Can scan for ancient cryptosleep caskets -->
  <LocalMineralScanner_ScanAncientCaskets>Kann nach antiken Kryptoschlafkapseln scannen</LocalMineralScanner_ScanAncientCaskets>
  <!-- EN: When enabled, the scanner can be tuned to the {0} and its variants, to reveal one sealed inside an undiscovered structure such as an ancient danger. Revealing a casket will not wake anything nearby. -->
  <LocalMineralScanner_ScanAncientCasketsDesc>Wenn aktiviert, kann der Scanner auf die {0} und ihre Varianten eingestellt werden, um eine Kapsel aufzudecken, die in einer unentdeckten Struktur wie einer antiken Gefahr eingeschlossen ist. Das Aufdecken einer Kapsel weckt nichts, was in der Nähe ruht.</LocalMineralScanner_ScanAncientCasketsDesc>
  <!-- Drawn indented under ScanAncientCaskets and disabled while that is off. -->
  <!-- EN: "Any mineral" can also reveal caskets -->
  <LocalMineralScanner_RandomIncludesCaskets>'Jedes Mineral' kann auch Kapseln aufdecken</LocalMineralScanner_RandomIncludesCaskets>
  <!-- EN: When enabled, a scanner tuned to any mineral can also reveal the {0} or one of its variants. When disabled, it will only reveal ore, but caskets can still be chosen from the tuning menu. -->
  <LocalMineralScanner_RandomIncludesCasketsDesc>Wenn aktiviert, kann ein auf jedes Mineral eingestellter Scanner auch die {0} oder eine ihrer Varianten aufdecken. Wenn deaktiviert, deckt er nur Erz auf, aber Kapseln lassen sich weiterhin im Einstellmenü auswählen.</LocalMineralScanner_RandomIncludesCasketsDesc>

  <!-- {0} = resource label (lower case, row is CapitalizeFirst()ed), {1} = count. -->
  <!-- EN: {0} cost: {1} -->
  <LocalMineralScanner_ResourceCost>Kosten für {0}: {1}</LocalMineralScanner_ResourceCost>
  <!-- EN: The amount of {0} needed to build one scanner. Set to 0 to remove it from the cost. -->
  <LocalMineralScanner_ResourceCostDesc>Die Menge an {0}, die zum Bau eines Scanners benötigt wird. Bei 0 entfällt dieser Kostenposten.</LocalMineralScanner_ResourceCostDesc>
</LanguageData>

<?xml version="1.0" encoding="utf-8"?>
<!-- Machine-assisted first pass (see l10n/process.md); pending native review.
     Only mod-specific strings live here; the tuning gizmo, inspect string and settings window
     reuse vanilla keys where the text is identical. NoFoggedDeposits and NoneUndiscovered are
     lower-case fragments: they are CapitalizeFirst()ed where shown. -->
<LanguageData>
  <!-- EN: Mineral deposit located -->
  <LocalMineralScanner_LetterLabelFoundDeposit>Обнаружено скопление минералов</LocalMineralScanner_LetterLabelFoundDeposit>
  <!-- EN: {FINDER_nameDef} has located a deposit of {0} in an undiscovered area using the local mineral scanner. -->
  <LocalMineralScanner_LetterFoundDeposit>{FINDER_nameDef} с помощью локального сканера минералов {FINDER_gender ? обнаружил : обнаружила} скопление {lookup: {0}; Case; 1} в необнаруженной области.</LocalMineralScanner_LetterFoundDeposit>
  <!-- EN: No more undiscovered {0} deposits remain on this map. The local mineral scanner will remain idle until it is tuned to another mineral. -->
  <LocalMineralScanner_MessageExhausted>На этой карте больше не осталось необнаруженных скоплений {lookup: {0}; Case; 1}. Локальный сканер минералов будет простаивать, пока не будет настроен на другой минерал.</LocalMineralScanner_MessageExhausted>
  <!-- EN: no undiscovered {0} deposits left -->
  <LocalMineralScanner_NoFoggedDeposits>не осталось необнаруженных скоплений {lookup: {0}; Case; 1}</LocalMineralScanner_NoFoggedDeposits>
  <!-- EN: none undiscovered -->
  <LocalMineralScanner_NoneUndiscovered>нет необнаруженных</LocalMineralScanner_NoneUndiscovered>
  <!-- EN: Combined scanning speed ({0} operators) -->
  <LocalMineralScanner_CombinedScanSpeed>Суммарная скорость сканирования ({0_numCase ? оператор : оператора : операторов})</LocalMineralScanner_CombinedScanSpeed>

  <!-- Ancient cryptosleep caskets (opt-in target). The letter's {0} arrives with its article
       ("an ancient cryptosleep casket"); the other two take the bare label ("ancient
       cryptosleep casket"), whose grammatical gender can differ between casket variants.
       NoFoggedCaskets is a lower-case fragment like NoFoggedDeposits. The letter stays neutral: caskets also sit in ruins
       and quest structures that hold nothing dangerous, so it must not call them a danger. -->
  <!-- EN: Casket located -->
  <LocalMineralScanner_LetterLabelFoundCasket>Обнаружен саркофаг</LocalMineralScanner_LetterLabelFoundCasket>
  <!-- EN: {FINDER_nameDef} has located {0} in an undiscovered area using the local mineral scanner. What it holds, and what else lies nearby, will only be known once the area is explored. -->
  <LocalMineralScanner_LetterFoundCasket>{FINDER_nameDef} с помощью локального сканера минералов {FINDER_gender ? обнаружил : обнаружила} в необнаруженной области находку: {0}. Что внутри и что ещё находится поблизости, выяснится только после исследования области.</LocalMineralScanner_LetterFoundCasket>
  <!-- EN: No undiscovered {0} remains on this map. The local mineral scanner will remain idle until it is tuned to something else. -->
  <LocalMineralScanner_MessageExhaustedCaskets>На этой карте больше не осталось необнаруженных объектов: {0}. Локальный сканер минералов будет простаивать, пока не будет настроен на что-то другое.</LocalMineralScanner_MessageExhaustedCaskets>
  <!-- EN: no undiscovered {0} left -->
  <LocalMineralScanner_NoFoggedCaskets>не осталось необнаруженных объектов: {0}</LocalMineralScanner_NoFoggedCaskets>
  <!-- Shown in place of NoFoggedCaskets / NoneUndiscovered for a scanner still tuned to a
       casket after the setting is turned off. Lower-case fragment. -->
  <!-- EN: disabled in mod settings -->
  <LocalMineralScanner_CasketsDisabled>отключено в настройках мода</LocalMineralScanner_CasketsDisabled>

  <!-- "Any mineral" tuning: the menu's first row, and the gizmo label after "Scan for:". Each
       find then reveals a random undiscovered target; whether caskets can be drawn is the
       RandomIncludesCaskets setting, so NothingUndiscovered (a lower-case fragment like
       NoFoggedDeposits) and MessageExhaustedAll are worded to hold either way. -->
  <!-- EN: Any mineral -->
  <LocalMineralScanner_AnyMineral>Любой минерал</LocalMineralScanner_AnyMineral>
  <!-- EN: nothing undiscovered left to find -->
  <LocalMineralScanner_NothingUndiscovered>не осталось ничего необнаруженного</LocalMineralScanner_NothingUndiscovered>
  <!-- EN: Nothing undiscovered remains on this map for the local mineral scanner to find. It will remain idle. -->
  <LocalMineralScanner_MessageExhaustedAll>На этой карте не осталось ничего необнаруженного, что мог бы найти локальный сканер минералов. Он будет простаивать.</LocalMineralScanner_MessageExhaustedAll>

  <!-- Settings window. *Desc keys are hover tooltips. SettingsCategory is also the Workshop
       title and must equal the first line of .steamworkshop/Description/<Language>.txt. -->
  <!-- EN: Local Mineral Scanner -->
  <LocalMineralScanner_SettingsCategory>Локальный сканер минералов</LocalMineralScanner_SettingsCategory>
  <!-- EN: Placement -->
  <LocalMineralScanner_SettingsPlacement>Расположение</LocalMineralScanner_SettingsPlacement>
  <!-- EN: Scanning -->
  <LocalMineralScanner_SettingsScanning>Сканирование</LocalMineralScanner_SettingsScanning>
  <!-- EN:  (default) -->
  <LocalMineralScanner_DefaultSuffix> (по умолчанию)</LocalMineralScanner_DefaultSuffix>
  <!-- EN:  ({0}) -->
  <LocalMineralScanner_VanillaSuffix> ({0})</LocalMineralScanner_VanillaSuffix>

  <!-- {0} = vanilla building label (long-range mineral scanner / deep drill). -->
  <!-- EN: Doesn't work under a roof -->
  <LocalMineralScanner_RequireUnroofed>Не работает под крышей</LocalMineralScanner_RequireUnroofed>
  <!-- EN: Like the {0}, it can't be placed or operated under a roof. Turn off to allow. -->
  <LocalMineralScanner_RequireUnroofedDesc>Как и {0}, его нельзя размещать или использовать под крышей. Отключите, чтобы разрешить.</LocalMineralScanner_RequireUnroofedDesc>
  <!-- EN: Can be uninstalled -->
  <LocalMineralScanner_Minifiable>Можно демонтировать</LocalMineralScanner_Minifiable>
  <!-- EN: Lets the scanner be uninstalled and moved, like the {0}. Turn off and it can only be deconstructed. -->
  <LocalMineralScanner_MinifiableDesc>Позволяет демонтировать сканер и переместить его, как {0}. Если отключить, сканер можно будет только разобрать.</LocalMineralScanner_MinifiableDesc>
  <!-- EN: Weight of the uninstalled scanner when hauled or carried by a caravan. -->
  <LocalMineralScanner_MassDesc>Масса демонтированного сканера при переноске или перевозке в караване.</LocalMineralScanner_MassDesc>

  <!-- {0} = the long-range mineral scanner's label, {1} = its own value for this setting. -->
  <!-- EN: Average working days between finds for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindMtbDaysDesc>Среднее число рабочих дней между находками для одного оператора при скорости исследования 100%. Для сравнения: {0} использует {1}.</LocalMineralScanner_FindMtbDaysDesc>
  <!-- EN: Guaranteed find within -->
  <LocalMineralScanner_FindGuaranteedDays>Гарантированное обнаружение через</LocalMineralScanner_FindGuaranteedDays>
  <!-- EN: Working days after which a find is guaranteed, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindGuaranteedDaysDesc>Число рабочих дней, после которого находка гарантирована для одного оператора при скорости исследования 100%. Для сравнения: {0} использует {1}.</LocalMineralScanner_FindGuaranteedDaysDesc>

  <!-- {0} = the vanilla ancient cryptosleep casket's label. -->
  <!-- EN: Can scan for ancient cryptosleep caskets -->
  <LocalMineralScanner_ScanAncientCaskets>Может искать древние саркофаги криптосна</LocalMineralScanner_ScanAncientCaskets>
  <!-- EN: Lists the {0} and its variants in the tuning menu whenever the map holds any, so the scanner can reveal one sealed inside an undiscovered structure such as an ancient danger. Revealing a casket does not wake whatever lies dormant nearby. -->
  <LocalMineralScanner_ScanAncientCasketsDesc>Добавляет в меню настройки сканера: {0} и его разновидности (если они есть на карте), чтобы сканер мог раскрыть саркофаг, запечатанный внутри необнаруженной постройки, например древней опасности. Раскрытие саркофага не пробуждает ничего неактивного поблизости.</LocalMineralScanner_ScanAncientCasketsDesc>
  <!-- Drawn indented under ScanAncientCaskets and disabled while that is off. -->
  <!-- EN: "Any mineral" can also reveal caskets -->
  <LocalMineralScanner_RandomIncludesCaskets>«Любой минерал» может также раскрывать саркофаги</LocalMineralScanner_RandomIncludesCaskets>
  <!-- EN: When tuned to any mineral, the scanner may also reveal the {0} or one of its variants, with the same chance per find as each mineral. Turn off to keep any-mineral finds to ore; caskets can still be tuned to directly. -->
  <LocalMineralScanner_RandomIncludesCasketsDesc>При настройке на любой минерал сканер может также раскрыть объекты: {0} и их разновидности, причём шанс при каждой находке такой же, как у любого минерала. Отключите, чтобы такие находки ограничивались рудой; настроить сканер на саркофаги напрямую по-прежнему можно.</LocalMineralScanner_RandomIncludesCasketsDesc>

  <!-- {0} = resource label (lower case, row is CapitalizeFirst()ed), {1} = count. -->
  <!-- EN: {0} cost: {1} -->
  <LocalMineralScanner_ResourceCost>Расход {lookup: {0}; Case; 1}: {1}</LocalMineralScanner_ResourceCost>
  <!-- EN: Amount of {0} needed to build one scanner. 0 removes it from the cost. -->
  <LocalMineralScanner_ResourceCostDesc>Количество {lookup: {0}; Case; 1}, необходимое для постройки одного сканера. Значение 0 исключает его из стоимости постройки.</LocalMineralScanner_ResourceCostDesc>
</LanguageData>

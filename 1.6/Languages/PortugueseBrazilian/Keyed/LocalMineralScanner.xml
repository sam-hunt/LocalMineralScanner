<?xml version="1.0" encoding="utf-8"?>
<!-- Only mod-specific strings live here; the tuning gizmo, inspect string and settings window
     reuse vanilla keys where the text is identical. NoFoggedDeposits is a lower-case fragment:
     it is CapitalizeFirst()ed where shown (forced-job fail text, inspect line). -->
<LanguageData>
  <!-- EN: Mineral deposit located -->
  <LocalMineralScanner_LetterLabelFoundDeposit>Depósito Mineral Localizado</LocalMineralScanner_LetterLabelFoundDeposit>
  <!-- EN: {FINDER_nameDef} has located a deposit of {0} in an undiscovered area using the local mineral scanner. -->
  <LocalMineralScanner_LetterFoundDeposit>{FINDER_nameDef} localizou um depósito de {0} em uma área inexplorada usando a escaneadora local de minerais.</LocalMineralScanner_LetterFoundDeposit>
  <!-- EN: No more undiscovered {0} deposits remain on this map. The local mineral scanner will remain idle until it is tuned to another mineral. -->
  <LocalMineralScanner_MessageExhausted>Não restam mais depósitos inexplorados de {0} neste mapa. A escaneadora local de minerais permanecerá ociosa até ser sintonizada para outro mineral.</LocalMineralScanner_MessageExhausted>
  <!-- EN: no undiscovered {0} deposits left -->
  <LocalMineralScanner_NoFoggedDeposits>nenhum depósito inexplorado de {0} restante</LocalMineralScanner_NoFoggedDeposits>
  <!-- EN: none undiscovered -->
  <LocalMineralScanner_NoneUndiscovered>nenhum inexplorado</LocalMineralScanner_NoneUndiscovered>
  <!-- EN: Combined scanning speed ({0} operators) -->
  <LocalMineralScanner_CombinedScanSpeed>Velocidade de escaneamento combinada ({0} operadores)</LocalMineralScanner_CombinedScanSpeed>

  <!-- Ancient cryptosleep caskets (opt-in target). The letter's {0} arrives with its article
       ("an ancient cryptosleep casket"); the other two take the bare label ("ancient
       cryptosleep casket"), whose grammatical gender can differ between casket variants.
       NoFoggedCaskets is a lower-case fragment like NoFoggedDeposits. The letter stays neutral: caskets also sit in ruins
       and quest structures that hold nothing dangerous, so it must not call them a danger. -->
  <!-- EN: Casket located -->
  <LocalMineralScanner_LetterLabelFoundCasket>Sarcófago Localizado</LocalMineralScanner_LetterLabelFoundCasket>
  <!-- EN: {FINDER_nameDef} has located {0} in an undiscovered area using the local mineral scanner. Explore the area to find out what is inside and what else lies nearby. -->
  <LocalMineralScanner_LetterFoundCasket>{FINDER_nameDef} localizou {0} em uma área inexplorada com a escaneadora local de minerais. Explore a área para descobrir o que há dentro e o que mais existe por perto.</LocalMineralScanner_LetterFoundCasket>
  <!-- EN: No undiscovered {0} remains on this map. The local mineral scanner will remain idle until it is tuned to something else. -->
  <LocalMineralScanner_MessageExhaustedCaskets>Não resta mais nenhum exemplar inexplorado de {0} neste mapa. A escaneadora local de minerais permanecerá ociosa até ser sintonizada para outra coisa.</LocalMineralScanner_MessageExhaustedCaskets>
  <!-- EN: no undiscovered {0} left -->
  <LocalMineralScanner_NoFoggedCaskets>não resta nenhum exemplar inexplorado de {0}</LocalMineralScanner_NoFoggedCaskets>
  <!-- Shown in place of NoFoggedCaskets / NoneUndiscovered for a scanner still tuned to a
       casket after the setting is turned off. Lower-case fragment. -->
  <!-- EN: disabled in mod settings -->
  <LocalMineralScanner_CasketsDisabled>desativado nas configurações do mod</LocalMineralScanner_CasketsDisabled>

  <!-- "Any mineral" tuning: the menu's first row, and the gizmo label after "Scan for:". Each
       find then reveals a random undiscovered target; whether caskets can be drawn is the
       RandomIncludesCaskets setting, so NothingUndiscovered (a lower-case fragment like
       NoFoggedDeposits) and MessageExhaustedAll are worded to hold either way. -->
  <!-- EN: Any mineral -->
  <LocalMineralScanner_AnyMineral>Qualquer mineral</LocalMineralScanner_AnyMineral>
  <!-- EN: nothing undiscovered left to find -->
  <LocalMineralScanner_NothingUndiscovered>nada inexplorado restante para encontrar</LocalMineralScanner_NothingUndiscovered>
  <!-- EN: Nothing undiscovered remains on this map for the local mineral scanner to find. It will remain idle. -->
  <LocalMineralScanner_MessageExhaustedAll>Não resta mais nada inexplorado neste mapa para a escaneadora local de minerais encontrar. Ela permanecerá ociosa.</LocalMineralScanner_MessageExhaustedAll>

  <!-- Settings window. *Desc keys are hover tooltips. SettingsCategory is also the Workshop
       title and must equal the first line of .steamworkshop/Description/<Language>.txt. -->
  <!-- EN: Local Mineral Scanner -->
  <LocalMineralScanner_SettingsCategory>Escaneadora Local de Minerais</LocalMineralScanner_SettingsCategory>
  <!-- EN: Placement -->
  <LocalMineralScanner_SettingsPlacement>Posicionamento</LocalMineralScanner_SettingsPlacement>
  <!-- EN: Scanning -->
  <LocalMineralScanner_SettingsScanning>Escaneamento</LocalMineralScanner_SettingsScanning>
  <!-- EN:  (default) -->
  <!-- Appended to a slider label; keep the leading space. VanillaSuffix marks a value one of
       vanilla's scanners uses; {0} = that scanner's label. -->
  <LocalMineralScanner_DefaultSuffix> (padrão)</LocalMineralScanner_DefaultSuffix>
  <!-- EN:  ({0}) -->
  <LocalMineralScanner_VanillaSuffix> ({0})</LocalMineralScanner_VanillaSuffix>

  <!-- {0} = vanilla building label (long-range mineral scanner / deep drill). -->
  <!-- EN: Doesn't work under a roof -->
  <LocalMineralScanner_RequireUnroofed>Não funciona debaixo de um telhado</LocalMineralScanner_RequireUnroofed>
  <!-- EN: When enabled, the scanner can't be built or operated under a roof, like the {0}. When disabled, it will work anywhere. -->
  <LocalMineralScanner_RequireUnroofedDesc>Quando ativado, a escaneadora não poderá ser construída nem operada debaixo de um telhado, como acontece com a {0}. Quando desativado, funcionará em qualquer lugar.</LocalMineralScanner_RequireUnroofedDesc>
  <!-- EN: Can be uninstalled -->
  <LocalMineralScanner_Minifiable>Pode ser desinstalada</LocalMineralScanner_Minifiable>
  <!-- EN: When enabled, the scanner can be uninstalled and moved, like the {0}. When disabled, it can only be deconstructed. -->
  <LocalMineralScanner_MinifiableDesc>Quando ativado, a escaneadora poderá ser desinstalada e movida, como acontece com a {0}. Quando desativado, só poderá ser desconstruída.</LocalMineralScanner_MinifiableDesc>
  <!-- EN: The mass of the uninstalled scanner when it is hauled or carried by a caravan. -->
  <LocalMineralScanner_MassDesc>A massa da escaneadora desinstalada ao ser transportada ou carregada por uma caravana.</LocalMineralScanner_MassDesc>

  <!-- {0} = the long-range mineral scanner's label, {1} = its own value for this setting. -->
  <!-- EN: The average number of working days between finds, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindMtbDaysDesc>O número médio de dias de trabalho entre localizações, com um operador a 100% de velocidade de pesquisa. A {0} usa {1}.</LocalMineralScanner_FindMtbDaysDesc>
  <!-- EN: Guaranteed find interval -->
  <LocalMineralScanner_FindGuaranteedDays>Intervalo de localização garantida</LocalMineralScanner_FindGuaranteedDays>
  <!-- EN: The number of working days until a find is guaranteed, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindGuaranteedDaysDesc>O número de dias de trabalho até garantir uma localização, com um operador a 100% de velocidade de pesquisa. A {0} usa {1}.</LocalMineralScanner_FindGuaranteedDaysDesc>

  <!-- {0} = the vanilla ancient cryptosleep casket's label. -->
  <!-- EN: Can scan for ancient cryptosleep caskets -->
  <LocalMineralScanner_ScanAncientCaskets>Pode escanear sarcófagos de criptosono antigos</LocalMineralScanner_ScanAncientCaskets>
  <!-- EN: When enabled, the scanner can be tuned to the {0} and its variants, to reveal one sealed inside an undiscovered structure such as an ancient danger. Revealing a casket will not wake anything nearby. -->
  <LocalMineralScanner_ScanAncientCasketsDesc>Quando ativado, a escaneadora poderá ser sintonizada para o {0} e suas variantes, para revelar um deles lacrado dentro de uma estrutura inexplorada, como um perigo ancestral. Revelar um sarcófago não despertará nada por perto.</LocalMineralScanner_ScanAncientCasketsDesc>
  <!-- Drawn indented under ScanAncientCaskets and disabled while that is off. -->
  <!-- EN: "Any mineral" can also reveal caskets -->
  <LocalMineralScanner_RandomIncludesCaskets>"Qualquer mineral" também pode revelar sarcófagos</LocalMineralScanner_RandomIncludesCaskets>
  <!-- EN: When enabled, a scanner tuned to any mineral can also reveal the {0} or one of its variants. When disabled, it will only reveal ore, but caskets can still be chosen from the tuning menu. -->
  <LocalMineralScanner_RandomIncludesCasketsDesc>Quando ativado, uma escaneadora sintonizada para qualquer mineral também poderá revelar o {0} ou uma de suas variantes. Quando desativado, só revelará minério, mas ainda será possível escolher sarcófagos no menu de sintonia.</LocalMineralScanner_RandomIncludesCasketsDesc>

  <!-- {0} = resource label (lower case, row is CapitalizeFirst()ed), {1} = count. -->
  <!-- EN: {0} cost: {1} -->
  <LocalMineralScanner_ResourceCost>Custo de {0}: {1}</LocalMineralScanner_ResourceCost>
  <!-- EN: The amount of {0} needed to build one scanner. Set to 0 to remove it from the cost. -->
  <LocalMineralScanner_ResourceCostDesc>A quantidade de {0} necessária para construir uma escaneadora. Defina como 0 para remover esse item do custo.</LocalMineralScanner_ResourceCostDesc>
</LanguageData>

<?xml version="1.0" encoding="utf-8"?>
<!-- Only mod-specific strings live here; the tuning gizmo, inspect string and settings window
     reuse vanilla keys where the text is identical. NoFoggedDeposits is a lower-case fragment:
     it is CapitalizeFirst()ed where shown (forced-job fail text, inspect line). -->
<LanguageData>
  <!-- EN: Mineral deposit located -->
  <LocalMineralScanner_LetterLabelFoundDeposit>礦脈尋獲</LocalMineralScanner_LetterLabelFoundDeposit>
  <!-- EN: {FINDER_nameDef} has located a deposit of {0} in an undiscovered area using the local mineral scanner. -->
  <LocalMineralScanner_LetterFoundDeposit>{FINDER_nameDef}透過在地礦物掃描器，在未探索的區域中發現了一處{0}礦脈。</LocalMineralScanner_LetterFoundDeposit>
  <!-- EN: No more undiscovered {0} deposits remain on this map. The local mineral scanner will remain idle until it is tuned to another mineral. -->
  <LocalMineralScanner_MessageExhausted>此地圖上已無未探索的{0}礦脈。在地礦物掃描器將保持閒置，直到被調整為其他礦物為止。</LocalMineralScanner_MessageExhausted>
  <!-- EN: no undiscovered {0} deposits left -->
  <LocalMineralScanner_NoFoggedDeposits>已無未探索的{0}礦脈</LocalMineralScanner_NoFoggedDeposits>
  <!-- EN: none undiscovered -->
  <LocalMineralScanner_NoneUndiscovered>無未探索</LocalMineralScanner_NoneUndiscovered>
  <!-- EN: Combined scanning speed ({0} operators) -->
  <LocalMineralScanner_CombinedScanSpeed>綜合掃描速度({0}位操作員)</LocalMineralScanner_CombinedScanSpeed>

  <!-- Ancient cryptosleep caskets (opt-in target). The letter's {0} arrives with its article
       ("an ancient cryptosleep casket"); the other two take the bare label ("ancient
       cryptosleep casket"), whose grammatical gender can differ between casket variants.
       NoFoggedCaskets is a lower-case fragment like NoFoggedDeposits. The letter stays neutral: caskets also sit in ruins
       and quest structures that hold nothing dangerous, so it must not call them a danger. -->
  <!-- EN: Casket located -->
  <LocalMineralScanner_LetterLabelFoundCasket>休眠艙尋獲</LocalMineralScanner_LetterLabelFoundCasket>
  <!-- EN: {FINDER_nameDef} has located {0} in an undiscovered area using the local mineral scanner. Explore the area to find out what is inside and what else lies nearby. -->
  <LocalMineralScanner_LetterFoundCasket>{FINDER_nameDef}透過在地礦物掃描器，在未探索的區域中發現了{0}。探索那個區域，就能知道艙裡裝著什麼，附近還有些什麼。</LocalMineralScanner_LetterFoundCasket>
  <!-- EN: No undiscovered {0} remains on this map. The local mineral scanner will remain idle until it is tuned to something else. -->
  <LocalMineralScanner_MessageExhaustedCaskets>此地圖上已無未探索的{0}。在地礦物掃描器將保持閒置，直到被調整為其他目標為止。</LocalMineralScanner_MessageExhaustedCaskets>
  <!-- EN: no undiscovered {0} left -->
  <LocalMineralScanner_NoFoggedCaskets>已無未探索的{0}</LocalMineralScanner_NoFoggedCaskets>
  <!-- Shown in place of NoFoggedCaskets / NoneUndiscovered for a scanner still tuned to a
       casket after the setting is turned off. Lower-case fragment. -->
  <!-- EN: disabled in mod settings -->
  <LocalMineralScanner_CasketsDisabled>已在模組設定中停用</LocalMineralScanner_CasketsDisabled>

  <!-- "Any mineral" tuning: the menu's first row, and the gizmo label after "Scan for:". Each
       find then reveals a random undiscovered target; whether caskets can be drawn is the
       RandomIncludesCaskets setting, so NothingUndiscovered (a lower-case fragment like
       NoFoggedDeposits) and MessageExhaustedAll are worded to hold either way. -->
  <!-- EN: Any mineral -->
  <LocalMineralScanner_AnyMineral>任何礦物</LocalMineralScanner_AnyMineral>
  <!-- EN: nothing undiscovered left to find -->
  <LocalMineralScanner_NothingUndiscovered>已無可尋獲的未探索目標</LocalMineralScanner_NothingUndiscovered>
  <!-- EN: Nothing undiscovered remains on this map for the local mineral scanner to find. It will remain idle. -->
  <LocalMineralScanner_MessageExhaustedAll>此地圖上已無未探索的目標可供在地礦物掃描器尋獲。它將保持閒置。</LocalMineralScanner_MessageExhaustedAll>

  <!-- Settings window. *Desc keys are hover tooltips. SettingsCategory is also the Workshop
       title and must equal the first line of .steamworkshop/Description/<Language>.txt. -->
  <!-- EN: Local Mineral Scanner -->
  <LocalMineralScanner_SettingsCategory>在地礦物掃描器</LocalMineralScanner_SettingsCategory>
  <!-- EN: Placement -->
  <LocalMineralScanner_SettingsPlacement>放置</LocalMineralScanner_SettingsPlacement>
  <!-- EN: Scanning -->
  <LocalMineralScanner_SettingsScanning>掃描</LocalMineralScanner_SettingsScanning>
  <!-- Appended to a slider label; keep the leading space. VanillaSuffix marks a value one of
       vanilla's scanners uses; {0} = that scanner's label. -->
  <!-- EN:  (default) -->
  <LocalMineralScanner_DefaultSuffix> (預設)</LocalMineralScanner_DefaultSuffix>
  <!-- EN:  ({0}) -->
  <LocalMineralScanner_VanillaSuffix> ({0})</LocalMineralScanner_VanillaSuffix>

  <!-- {0} = vanilla building label (long-range mineral scanner / deep drill). -->
  <!-- EN: Doesn't work under a roof -->
  <LocalMineralScanner_RequireUnroofed>無法在屋頂下運作</LocalMineralScanner_RequireUnroofed>
  <!-- EN: When enabled, the scanner can't be built or operated under a roof, like the {0}. When disabled, it will work anywhere. -->
  <LocalMineralScanner_RequireUnroofedDesc>啟用後，掃描器和{0}一樣，無法在屋頂下建造或操作。禁用後，則可在任何地方運作。</LocalMineralScanner_RequireUnroofedDesc>
  <!-- EN: Can be uninstalled -->
  <LocalMineralScanner_Minifiable>可以移除</LocalMineralScanner_Minifiable>
  <!-- EN: When enabled, the scanner can be uninstalled and moved, like the {0}. When disabled, it can only be deconstructed. -->
  <LocalMineralScanner_MinifiableDesc>啟用後，掃描器可以像{0}一樣移除並搬運。禁用後，就只能拆除。</LocalMineralScanner_MinifiableDesc>
  <!-- EN: The mass of the uninstalled scanner when it is hauled or carried by a caravan. -->
  <LocalMineralScanner_MassDesc>已移除安裝的掃描器在搬運或由旅隊攜帶時的質量。</LocalMineralScanner_MassDesc>

  <!-- {0} = the long-range mineral scanner's label, {1} = its own value for this setting. -->
  <!-- EN: The average number of working days between finds, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindMtbDaysDesc>一名操作員以100%研究速度工作時，平均要工作幾天才會再尋獲一次。{0}使用{1}。</LocalMineralScanner_FindMtbDaysDesc>
  <!-- EN: Guaranteed find interval -->
  <LocalMineralScanner_FindGuaranteedDays>保證尋獲間隔</LocalMineralScanner_FindGuaranteedDays>
  <!-- EN: The number of working days until a find is guaranteed, for one operator at 100% research speed. The {0} uses {1}. -->
  <LocalMineralScanner_FindGuaranteedDaysDesc>一名操作員以100%研究速度工作時，要工作幾天才必定會尋獲。{0}使用{1}。</LocalMineralScanner_FindGuaranteedDaysDesc>

  <!-- {0} = the vanilla ancient cryptosleep casket's label. -->
  <!-- EN: Can scan for ancient cryptosleep caskets -->
  <LocalMineralScanner_ScanAncientCaskets>可以掃描遠古休眠艙</LocalMineralScanner_ScanAncientCaskets>
  <!-- EN: When enabled, the scanner can be tuned to the {0} and its variants, to reveal one sealed inside an undiscovered structure such as an ancient danger. Revealing a casket will not wake anything nearby. -->
  <LocalMineralScanner_ScanAncientCasketsDesc>啟用後，掃描器可以調整為{0}及其變體，用來揭露遠古威脅等未探索結構裡封存的休眠艙。揭露休眠艙不會喚醒附近的任何東西。</LocalMineralScanner_ScanAncientCasketsDesc>
  <!-- Drawn indented under ScanAncientCaskets and disabled while that is off. -->
  <!-- EN: "Any mineral" can also reveal caskets -->
  <LocalMineralScanner_RandomIncludesCaskets>「任何礦物」也可能揭露休眠艙</LocalMineralScanner_RandomIncludesCaskets>
  <!-- EN: When enabled, a scanner tuned to any mineral can also reveal the {0} or one of its variants. When disabled, it will only reveal ore, but caskets can still be chosen from the tuning menu. -->
  <LocalMineralScanner_RandomIncludesCasketsDesc>啟用後，掃描器調整為任何礦物時，也可能揭露{0}或其變體。禁用後，則只會揭露礦物，但仍可從調整選單中選擇休眠艙。</LocalMineralScanner_RandomIncludesCasketsDesc>

  <!-- {0} = resource label (lower case, row is CapitalizeFirst()ed), {1} = count. -->
  <!-- EN: {0} cost: {1} -->
  <LocalMineralScanner_ResourceCost>{0}消費：{1}</LocalMineralScanner_ResourceCost>
  <!-- EN: The amount of {0} needed to build one scanner. Set to 0 to remove it from the cost. -->
  <LocalMineralScanner_ResourceCostDesc>建造一台掃描器所需的{0}數量。設為0即可從建造成本中移除。</LocalMineralScanner_ResourceCostDesc>
</LanguageData>

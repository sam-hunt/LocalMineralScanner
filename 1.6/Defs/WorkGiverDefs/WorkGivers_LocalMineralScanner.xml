<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Custom giverClass: assigns each pawn a free cell from Thing.InteractionCells so two
       pawns can work one scanner (rationale in WorkGiver_OperateLocalMineralScanner.cs).
       scannerDef is vanilla WorkGiverDef API, reused so the class stays generic over future
       scanners. workType Research keeps parity with vanilla scanners (Intellectual-priority
       work, ResearchSpeed scan stat, Intellectual XP in the driver). -->
  <WorkGiverDef>
    <defName>LocalMineralScan</defName>
    <label>operate local mineral scanner</label>
    <giverClass>LocalMineralScanner.WorkGiver_OperateLocalMineralScanner</giverClass>
    <workType>Research</workType>
    <priorityInType>50</priorityInType>
    <verb>scan at</verb>
    <gerund>scanning at</gerund>
    <scannerDef>LocalMineralScanner</scannerDef>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

</Defs>

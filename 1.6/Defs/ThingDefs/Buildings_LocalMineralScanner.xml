<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Pawn-operated 2x2 scanner that unfogs one deposit of its tuned mineral per find.
       Modeled on vanilla's LongRangeMineralScanner; every deviation is explained in
       Docs/design-research.md (ThingDef values). Mod settings overwrite costList, Mass,
       minifiedDef, canBeUsedUnderRoof and the scanFind* days at startup, so those XML
       values must equal the *Default consts in LocalMineralScannerSettings.cs. -->
  <ThingDef ParentName="BuildingBase">
    <defName>LocalMineralScanner</defName>
    <label>local mineral scanner</label>
    <description>A short-range lateral sensor unit used by researchers to detect mineral deposits hidden in the surrounding terrain. The chance to find a deposit depends on the operator's research ability. This sensor can be tuned to target a specific mineral type, and its twin consoles allow two operators to scan at once. It doesn't work under a roof. Can be repositioned freely.</description>
    <graphicData>
      <texPath>Things/Building/Misc/LocalMineralScanner</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.8, 2.8)</drawSize>
      <shadowData>
        <volume>(0.95, 0.35, 0.95)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <size>(2,2)</size>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <uninstallWork>1500</uninstallWork>
    </building>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="LocalMineralScanner.CompProperties_LocalMineralScanner">
        <scanSpeedStat>ResearchSpeed</scanSpeedStat>
        <scanFindMtbDays>4</scanFindMtbDays>
        <scanFindGuaranteedDays>8</scanFindGuaranteedDays>
        <soundWorking>ScannerLongRangeMineral_Ambience</soundWorking>
      </li>
    </comps>
    <placeWorkers>
      <li>LocalMineralScanner.PlaceWorker_NotUnderRoofIfRequired</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <altitudeLayer>Building</altitudeLayer>
    <canBeUsedUnderRoof>false</canBeUsedUnderRoof>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-8</Beauty>
      <Mass>40</Mass>
    </statBases>
    <fillPercent>0.40</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2998</uiOrder>
    <rotatable>true</rotatable>
    <multipleInteractionCellOffsets>
      <li>(0,0,2)</li>
      <li>(1,0,2)</li>
    </multipleInteractionCellOffsets>
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <interactionCellIconReverse>true</interactionCellIconReverse>
    <defaultPlacingRot>South</defaultPlacingRot>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>LongRangeMineralScanner</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Custom driver: reserves the operator cell in targetB rather than the building, so two
       pawns can work one scanner (rationale in WorkGiver_OperateLocalMineralScanner.cs).
       targetA = scanner building, targetB = assigned interaction cell. -->
  <JobDef>
    <defName>OperateLocalMineralScanner</defName>
    <driverClass>LocalMineralScanner.JobDriver_OperateLocalMineralScanner</driverClass>
    <reportString>scanning at TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

</Defs>

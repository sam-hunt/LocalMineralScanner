<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Architect > Misc: slot the local scanner directly after vanilla's long-range mineral
       scanner. Gizmos sort by uiOrder with ties in load order, so the three vanilla defs
       are lowered from the 2999 default to our 2998; see Docs/design-research.md (Architect
       menu order). Conditional so an existing uiOrder is replaced, not duplicated. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="MoisturePump"]/uiOrder</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="MoisturePump"]/uiOrder</xpath>
      <value><uiOrder>2998</uiOrder></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="MoisturePump"]</xpath>
      <value><uiOrder>2998</uiOrder></value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/uiOrder</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]/uiOrder</xpath>
      <value><uiOrder>2998</uiOrder></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="GroundPenetratingScanner"]</xpath>
      <value><uiOrder>2998</uiOrder></value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="LongRangeMineralScanner"]/uiOrder</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="LongRangeMineralScanner"]/uiOrder</xpath>
      <value><uiOrder>2998</uiOrder></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="LongRangeMineralScanner"]</xpath>
      <value><uiOrder>2998</uiOrder></value>
    </nomatch>
  </Operation>

</Patch>
